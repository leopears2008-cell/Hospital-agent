# Clerk authentication (required; no mock authentication fallback)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Comma-separated Clerk user IDs. Privileged roles are granted only from these server-side allowlists.
ADMIN_USER_IDS=
DOCTOR_USER_IDS=

# Gemini AI
GEMINI_API_KEY=

# Persistent production database (Turso/libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Alternatively set DATABASE_URL to a compatible libSQL URL

PORT=3000
NODE_ENV=development
