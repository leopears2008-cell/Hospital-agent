rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isDoctor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin() || isDoctor());
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    match /appointments/{appointmentId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }
  }
}
