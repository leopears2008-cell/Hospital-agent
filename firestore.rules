rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // Hardcoded admin email restriction
      return isSignedIn() && request.auth.token.email == 'leopears2008@gmail.com';
    }
    function isDoctor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin() || isDoctor());
      // Users can update their own doc, but we should technically prevent them from changing their role to admin.
      // Easiest is to just rely on the hardcoded isAdmin check above for real admin actions.
      allow write: if isSignedIn() && (userId == request.auth.uid || isAdmin());
    }
    
    match /appointments/{appointmentId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isDoctor() || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
